datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id          Int     @id @default(autoincrement())
  title       String
  description String?
  price       Int      // in cents
  image       String?  // store image URL
}


model Order {
  id        Int      @id @default(autoincrement())
  total     Int
  createdAt DateTime @default(now())
}


model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}
